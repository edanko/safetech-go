# EditorConfig: https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 2
trim_trailing_whitespace = true

# Go uses tabs; gofmt controls the visual width.
[*.go]
indent_style = tab
tab_width = 4

[*.{yml,yaml,json,md}]
indent_style = space
indent_size = 2

# Markdown uses two trailing spaces for hard line breaks.
[*.md]
trim_trailing_whitespace = false

# Makefile recipes require tabs.
[Makefile]
indent_style = tab
tab_width = 4
